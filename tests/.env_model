# API variables used for Codeception tests running

LADECADANSE_API_URL= # for ex. : http://ladecadanse.local/event/api.php
LADECADANSE_API_USER=
LADECADANSE_API_KEY=
LADECADANSE_API_KEY_QUERY_DATE= # for ex. : "2023-06-02"
LADECADANSE_API_KEY_QUERY_ENDTIME= # for ex. : "01:00:00"

LADECADANSE_SITE_URL= # base URL of the site under test, for ex. : http://ladecadanse.local

# Site suite : accounts (see tests/README.md).
# Tests needing a variable left empty are skipped, not failed.
LADECADANSE_SITE_ADMIN_USER= # a user with groupe <= 4
LADECADANSE_SITE_ADMIN_PASS=
LADECADANSE_SITE_ACTOR_USER= # a user with groupe 8
LADECADANSE_SITE_ACTOR_PASS=

# Site suite : fixtures (existing events on the instance under test)
# A past event is locked (read-only archive) for anyone below groupe 6, so the fixtures
# below must be *future* events unless their name says otherwise.
LADECADANSE_TEST_EVENT_ID_AUTEUR=    # future event submitted by an author (groupe >= 6) or anonymously
LADECADANSE_TEST_EVENT_ID_ACTOR_OWN= # future event whose author is LADECADANSE_SITE_ACTOR_USER
LADECADANSE_TEST_EVENT_ID_FOREIGN=   # event LADECADANSE_SITE_ACTOR_USER may not edit
LADECADANSE_TEST_EVENT_ID_ACTOR_OWN_PAST= # past event whose author is LADECADANSE_SITE_ACTOR_USER

# Site suite : fixtures for the past-events sort menu (lieu/lieu.php, organisateur/organisateur.php)
LADECADANSE_TEST_LIEU_ID_WITH_PAST_EVENTS= # a lieu with several past events, spread over several dates
LADECADANSE_TEST_ORGA_ID_WITH_PAST_EVENTS= # an organisateur with at least one past event
