# 0 basic checks, unknown classes, unknown functions, unknown methods called on $this, wrong number of arguments passed to those methods and functions, always undefined variables
# 1 possibly undefined variables, unknown magic methods and properties on classes with __call and __get
# 2 unknown methods checked on all expressions (not just $this), validating PHPDocs
# 3 return types, types assigned to properties
# 4 basic dead code checking - always false instanceof and other type checks, dead else branches, unreachable code after return; etc.
# 5 checking types of arguments passed to methods and functions
# 6 report missing typehints
# 7 report partially wrong union types - if you call a method that only exists on some types in a union type, level 7 starts to report that; other possibly incorrect situations
# ...

parameters:
    paths:
        - .
    excludePaths:
        - .claude
        - web
        - vendor
        - var
        - tests
        - node_modules (?)
    fileExtensions:
        - php
    tmpDir: var/cache/phpstan
    level: 4 # 5+ trop d'erreurs (because vieux code) ; prochain objectif : 5 (types des arguments)
    phpVersion: 80400
    bootstrapFiles:
        # constantes définies au runtime (app/config.php, app/bootstrap.php)
        - phpstan-constants.php
    # constantes de app/env.php qui varient selon l'environnement : sans cette
    # liste, PHPStan fige leur valeur locale et signale de faux "always true/false"
    dynamicConstantNames:
        - ENV
        - MODE_DEBUG
        - EMAIL_SMTPAUTH
        - EMAIL_COPY_TO_ADMIN
        - MATOMO_ENABLED
        - GLITCHTIP_ENABLED
        - DARKVISITORS_ENABLED
        - LADECADANSE_API_ENABLED
        - BOT_MONITORING_ENABLED
        - HOME_TMP_BANNER_ENABLED
        - HOME_TMP_BACK_BANNER_ENABLED
        - PARTIAL_EDIT_MODE
    inferPrivatePropertyTypeFromConstructor: true
    checkMissingTypehints: true
    ignoreErrors:
        # Pattern legacy : les pages comptent sur des variables définies par les
        # fichiers qui les incluent (bootstrap, _header). Ignoré seulement hors de
        # librairies/, où le code OOP doit rester propre.
        -
            identifier: variable.undefined
            reportUnmatched: false
            paths:
                - admin
                - app
                - articles
                - event
                - lieu
                - misc
                - organisateur
                - user
                - _footer.inc.php
                - _header.inc.php
                - _texte_repliable.inc.php
                - annuaire-membres.php
                - evenement-edit.php
                - index.php
                - lieu-edit.php
                - lieu-text-edit.php
                - organisateur-edit.php
                - user-edit.php
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - phpstan-baseline.neon
