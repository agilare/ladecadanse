<?xml version="1.0"?>
<!--
    Configuration du banc de contrôle de la teinte — voir .psalm/README.md

    Elle reprend celle de psalm.xml : même périmètre, mêmes plugins, mêmes extensions, mêmes
    globales. Ce qui change tient en deux points.

    1. .psalm/ n'est plus ignoré, pour que le banc soit analysé — mais .psalm/src reste dehors,
       le plugin n'ayant pas à s'analyser lui-même.

    2. <fileExtensions> ajoute .txt, le banc étant nommé .php.txt : cette extension le tient
       hors de portée de PHPStan, Rector et phpcs, qui partent tous de la racine du dépôt.

    Le périmètre est celui du dépôt entier, et non le banc seul, parce que Psalm ne relie un
    appel à son sink que s'il a analysé tout le chemin. Réduit à librairies/ et app/, le banc
    perdait le sink PDO : Psalm ne sait que $this->pdo porte un PDO qu'après avoir analysé le
    constructeur de DbConnectorPdo, appelé par du code que ce périmètre ne contenait pas.
    L'analyse dure une trentaine de secondes, contre une quinzaine pour le banc seul.

    Toute modification de psalm.xml qui touche à la teinte est à reporter ici, sans quoi le
    banc cesse de dire la vérité sur la configuration réelle.
-->
<psalm
    phpVersion="8.4"
    errorLevel="7"
    resolveFromConfigFile="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    allConstantsGlobal="true"
    ensureOverrideAttribute="false"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles allowMissingFiles="true">
            <directory name=".claude"/>
            <directory name=".psalm/src"/>
            <directory name="docker"/>
            <directory name="node_modules"/>
            <directory name="resources"/>
            <directory name="tests"/>
            <directory name="var"/>
            <directory name="web"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name=".php"/>
        <extension name=".txt"/>
    </fileExtensions>
    <!-- Pas de <enableExtensions> : pdo et mysqli viennent du `require` de composer.json,
         que Psalm lit depuis le répertoire courant (resolveFromConfigFile="false"). -->
    <plugins>
        <pluginClass class="Ladecadanse\Psalm\SessionTaintPlugin"/>
    </plugins>
    <!-- Mêmes globales que psalm.xml : le banc prend ses connecteurs en `global`, comme le site. -->
    <globals>
        <var name="connector" type="Ladecadanse\Utils\DbConnector"/>
        <var name="connectorPdo" type="Ladecadanse\Utils\DbConnectorPdo"/>
        <var name="authorization" type="Ladecadanse\Security\Authorization"/>
        <var name="videur" type="Ladecadanse\Security\Sentry"/>
        <var name="tplEngine" type="Ladecadanse\TemplateEngine"/>
        <var name="translator" type="Ladecadanse\Translator"/>
        <var name="assets" type="Ladecadanse\Utils\AssetManager"/>
        <var name="logger" type="Monolog\Logger"/>
        <var name="loggerApi" type="Monolog\Logger"/>
        <var name="site_full_url" type="string"/>
        <var name="nom_page" type="string"/>
        <var name="auj" type="string"/>
        <var name="glo_auj" type="string"/>
        <var name="glo_auj_6h" type="string"/>
        <var name="glo_regions" type="array&lt;string, string&gt;"/>
        <var name="glo_menu_pratique" type="array&lt;string, string&gt;"/>
        <var name="glo_tab_genre" type="array&lt;string, string&gt;"/>
        <var name="glo_tab_ailleurs" type="array&lt;string, string&gt;"/>
        <var name="glo_tab_quartiers" type="list&lt;string&gt;"/>
        <var name="glo_tab_quartiers2" type="array&lt;string, list&lt;string&gt;&gt;"/>
        <var name="mimes_images_acceptes" type="list&lt;string&gt;"/>
        <var name="mimes_documents_acceptes" type="list&lt;string&gt;"/>
        <var name="rep_images_even" type="string"/>
        <var name="rep_uploads_lieux" type="string"/>
        <var name="rep_uploads_lieux_galeries" type="string"/>
        <var name="rep_uploads_organisateurs" type="string"/>
        <var name="rep_fichiers_lieu" type="string"/>
        <var name="url_images_interface_icons" type="string"/>
        <var name="url_query_region" type="string"/>
        <var name="url_query_region_et" type="string"/>
        <var name="url_query_region_1er" type="string"/>
        <var name="icone" type="array&lt;string, string&gt;"/>
        <var name="iconeEditer" type="string"/>
        <var name="iconeCopier" type="string"/>
        <var name="page_titre" type="string"/>
        <var name="evenement" type="array"/>
        <var name="calLinks" type="array"/>
    </globals>
</psalm>
