<main id="contenu" class="colonne">

    {% for banner in home_banners %}
        <div class="alert-{{ banner.type }} js-home-banner" data-banner-key="{{ banner.key }}">
            <h2>{{ banner.titre|raw }}</h2><a href="#" class="js-alert-close-btn close" aria-label="Fermer">&times;</a>
            <p>{{ banner.contenu|raw }}</p>
        </div>
    {% endfor %}
    {% if home_banners is not empty %}
        {# exécuté avant l'affichage : une bannière déjà fermée ne clignote pas ; sans JS elle reste visible #}
        <script nonce="{{ csp_nonce }}">
            document.querySelectorAll('.js-home-banner').forEach(function (banner) {
                try {
                    if (localStorage.getItem(banner.dataset.bannerKey) !== null) {
                        banner.hidden = true;
                    }
                } catch (e) {}
            });
        </script>
    {% endif %}

    {% if flash_msg %}
        {{ msg_ok(flash_msg) }}
    {% endif %}

    <header id="entete_contenu">
        <hgroup>
            <h1 class="accueil">{{ courant|date_fr|ucfirst }}<sup style="font-size:0.7em;color:#999">{{ count_events }}</sup>
                {% if courant_year != current_year %}{{ courant_year }}{% endif %}
                {% if is_courant_today %}
                <small><span>Aujourd’hui</span>&nbsp;<a href="{{ site_canonical_url }}/event/rss.php?type=evenements_auj" title="Flux RSS des événements du jour" class="desktop"><i class="fa fa-rss fa-lg"></i></a></small>{% endif %}
            </h1>
        </hgroup>
        <ul class="entete_contenu_navigation">
            <li><a href="index.php?courant={{ date_prev }}" rel="prev nofollow" title="Jour précédent" aria-label="Jour précédent">{{ icons.precedent }}</a></li><li><a href="index.php?courant={{ date_next }}" rel="next nofollow">{% if is_courant_today %}Demain{% else %}Lendemain{% endif %} {{ icons.suivant }}</a></li>
        </ul>
    </header>

    <div id="prochains_evenements">

        {# Une préversion qui ne se signale pas se croit livrée : l'administrateur qui l'éprouve
           doit voir qu'il est seul à disposer de ces repères, et à quelle heure ils sont figés. #}
        {% if time_status_preview %}
            <p class="even-time-preview"><i class="fa fa-clock-o" aria-hidden="true"></i>&nbsp;Repères de temporalité en préversion : vous seuls, administrateurs, les voyez</p>
        {% endif %}

        {# une seule bulle pour tous les boutons « ? » de la liste : global.js la remplit et la place #}
        {% if time_status_enabled %}
            <div id="even-time-estimate-popover" class="even-time-estimate-popover" popover></div>
        {% endif %}

        {# Même raison : sans cette ligne, un administrateur classe en « cours » sans savoir
           que le public lit toujours « divers ». La seconde phrase est la plus utile. #}
        {% if new_categories_preview %}
            <p class="even-time-preview"><i class="fa fa-filter" aria-hidden="true"></i>&nbsp;« Cours/ateliers/stages » est en préversion : vous seuls, administrateurs, voyez cette catégorie. Pour tous les autres, un cours reste rangé dans « divers ».</p>
        {% endif %}

        {# les deux menus partagent une ligne à partir de 800px, cf. #agenda_filters dans
           index.css ; l'ordre du DOM suit l'ordre visuel (filtrer, puis trier). Les jours
           sans événement, il n'y a rien à filtrer : sans la classe le conteneur reste en
           display:contents et le menu de tri s'affiche seul, comme avant le filtre. #}
        {% set show_genre_tabs = count_events > 0 %}
        {% set genre_tab_all = constant('Ladecadanse\\EventCategory::TAB_ALL') %}
        {% set genres_today = events_by_category|keys %}
        <div id="agenda_filters"{% if show_genre_tabs %} class="avec-filtre-genre"{% endif %}>

            {% if show_genre_tabs %}
            <nav id="genre_tab_navigation" aria-label="Filtrer par genre">
                <ul>
                    <li><i class="fa fa-filter fa-lg" aria-hidden="true"></i></li>
                    {% for key, label in selectable_categories %}
                        {% if current_genre_tab == key %}
                            <li class="ici" aria-current="true"><a href="index.php?genre_tab={{ genre_tab_all }}{{ url_filter_params }}" title="Retirer le filtre" aria-label="Retirer le filtre {{ label|ucfirst }}" rel="nofollow">{{ label|ucfirst }}&nbsp;<i class="fa fa-times" aria-hidden="true"></i></a></li>
                        {% elseif key in genres_today %}
                            <li><a href="index.php?genre_tab={{ key|url_encode }}{{ url_filter_params }}" rel="nofollow">{{ label|ucfirst }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>
            {% endif %}

            {{ favoris_filter_html }}

            <div id="order_navigation">
                <ul>
                    <li style="margin-right:5px"><i class="fa fa-sort-amount-asc" aria-hidden="true"></i></li>{% for order, label in agenda_orders %}<li{% if loop.first %} style="margin-right:2px"{% endif %}><a href="index.php?tri_agenda={{ order }}{{ url_courant_param }}" class="{% if agenda_order == order %}selected{% endif %}" rel="nofollow">{{ label }}</a></li>{% endfor %}
                </ul>
                <div class="spacer"></div>
            </div>

        </div>

        {% if count_events == 0 %}
            {{ msg_info('Pas d’événement prévu ce jour') }}
        {% elseif current_genre_tab != genre_tab_all and current_genre_tab not in genres_today %}
            {{ msg_info('Pas d’événement « ' ~ category_label(current_genre_tab)|ucfirst ~ ' » prévu ce jour') }}
        {% endif %}

        {% for genre, genre_events in events_by_category %}
            {% if current_genre_tab == genre_tab_all or genre == current_genre_tab %}
                <section class="genre">

                    <header class="genre-titre">
                        <h2 id="{{ category_label(genre)|category_anchor }}">{{ category_label(genre)|ucfirst }}</h2>
                        {% set genre_next = genres_today[loop.index] ?? null %}
                        {% if current_genre_tab == genre_tab_all and genre_next is not null %}
                            <a class="genre-jump" href="#{{ category_label(genre_next)|category_anchor }}">{{ category_label(genre_next) }}&nbsp;<i class="fa fa-long-arrow-down"></i></a>
                        {% endif %}
                        <div class="spacer"></div>
                    </header>

                    {% for event in events_with_separators(genre_events, is_chronological_order, courant) %}

                        {% if event.separator %}
                            <p class="rappel_date">{{ event.separator.label(day_label, category_label(genre))|raw }}</p>
                        {% endif %}

                        {% set tab_even = event.event %}
                        {{ event_short_article(tab_even, orgas, time_status_enabled) }}

                            <footer class="edition">

                                <ul class="menu_action">
                                    <li><a href="/event/send.php?action=report&idE={{ tab_even.e_idEvenement|int }}" class="signaler" title="Signaler une erreur"><i class="fa fa-flag-o fa-lg"></i></a></li>
                                    {{ event_calendar_menu(tab_even, site_full_url, compact = true) }}
                                    <li>{{ event_favorite_button(tab_even.e_idEvenement|int) }}</li>
                                </ul>

                                {% if can_edit_event(tab_even) %}
                                {# Icônes seules, comme dans les listes de lieu, d'organisateur et de
                                   recherche : le libellé passe dans l'infobulle et dans l'alt de l'image.
                                   Les classes action_* sont donc retirées — elles portaient la même
                                   icône en fond, qui ferait doublon avec celle-ci. #}
                                <ul class="menu_edition">
                                    <li>
                                        <a href="/event/copy.php?idE={{ tab_even.e_idEvenement|int }}" title="Copier vers d'autres dates">{{ icons.copier }}</a>
                                    </li>
                                    {% if can_edit_event_now(tab_even) %}
                                    <li>
                                        <a href="/evenement-edit.php?action=editer&amp;idE={{ tab_even.e_idEvenement|int }}" title="Modifier l'événement">{{ icons.editer }}</a>
                                    </li>
                                    {% endif %}
                                    <li>
                                        {{ event_unpublish_link(tab_even.e_idEvenement|int, icons.depublier) }}
                                    </li>
                                    {% if can_manage_event(tab_even) %}
                                    <li>
                                        <a href="/user/dashboard.php?idP={{ tab_even.e_idPersonne|int }}" title="Fiche de l'auteur" aria-label="Fiche de l'auteur">{{ icons.personne }}</a>
                                    </li>
                                    {% endif %}
                                </ul>
                                {% endif %}

                            </footer> <!-- fin edition -->

                            <div class="spacer"></div>

                        </article> <!-- evenement -->

                    <div class="spacer"></div>

                    {% endfor %}

            </section>
            {% endif %}
        {% endfor %}

        <ul class="entete_contenu_navigation">
            <li><a href="index.php?courant={{ date_prev }}" rel="prev nofollow" title="Jour précédent" aria-label="Jour précédent">{{ icons.precedent }}</a></li><li><a href="index.php?courant={{ date_next }}" rel="next nofollow">{{ date_next|date_fr('tout', false)|ucfirst }}{{ icons.suivant }}</a></li>
        </ul>

    </div> <!-- prochains_evenements -->

</main>

<aside id="colonne_gauche" class="colonne">

    {{ calendar_html }}
    {% if is_courant_today %}
        <div class="secondaire">

            <ul class="autour">
                <li><a href="https://www.facebook.com/ladecadanse" aria-label="Page Facebook" style="font-size:1em" target="_blank"><i class="fa fa-facebook fa-2x" aria-hidden="true"></i></a></li>
                <li style="margin-left:10px;font-size:1em"><a href="https://github.com/agilare/ladecadanse/" aria-label="Watch agilare/ladecadanse on GitHub" target="_blank"><i class="fa fa-github fa-2x" aria-hidden="true"></i></a>
                </li>
                <li id="faireundon_btn" class="clear_mobile_important"><a href="/articles/faireUnDon.php">Faire un don</a>
                </li>
            </ul>

            <section class="partenaires">
                <h2>Partenaires</h2>
                <ul class="autour">
                    <li><a href="https://olivedks.ch/" target="_blank"><img src="/web/content/debout-les-braves-s.jpg" alt="Debout les braves - Visions de la scène genevoise et d'ailleurs" title="Debout les braves - Visions de la scène genevoise et d'ailleurs" width="150" height="63"></a></li>
                    <li><a href="https://culture-accessible.ch/" target="_blank"><img src="/web/content/culture-accessible-geneve.svg" alt="Culture accessible Genève" width="150" height="46"></a></li>
                    <li><a href="https://epic-magazine.ch/" target="_blank"><img src="/web/content/EPIC_noir.png" alt="EPIC Magazine" width="150" height="94"></a></li>
                    <li><a href="https://www.radiovostok.ch/" target="_blank"><img src="/web/content/radio-vostok.png" alt="Radio Vostok" width="150" height="90"></a></li>
                    <li><a href="https://www.darksite.ch/" target="_blank"><img src="/web/content/darksite.png" alt="Darksite" width="150" height="43"></a></li>
                </ul>
            </section>
        </div>
    {% endif %}
</aside>
<!-- Fin Colonnegauche -->

<aside id="colonne_droite" class="colonne">

    {% if is_courant_today %}

        <section id="latests_events" class="secondaire">

            <span class="lien_rss"><a href="{{ site_canonical_url }}/event/rss.php?type=evenements_ajoutes" aria-label="Flux RSS des derniers événements"><i class="fa fa-rss fa-lg"></i></a></span>

            <h2>Derniers événements ajoutés</h2>

            <div id="derniers_evenements">

                {% for tab_even in latest_events %}
                    {% set even_lieu = event_lieu(tab_even) %}
                    <div class="dernier_evenement">

                        <figure class="flyer">{{ event_main_figure(tab_even.e_flyer, tab_even.e_image, tab_even.e_titre, constant('Ladecadanse\\EvenementRenderer::SMALL_FIGURE_WIDTH')) }}</figure>

                        <div class="texte">
                            <h3><a href="/event/evenement.php?idE={{ tab_even.e_idEvenement|int }}">{{ event_title(tab_even.e_titre, tab_even.e_statut) }}</a></h3>
                            <span>{{ lieu_link_name(even_lieu.nom, even_lieu.idLieu, even_lieu.salle) }}</span>

                            <p>le&nbsp;<a href="index.php?courant={{ tab_even.e_dateEvenement|url_encode }}">{{ tab_even.e_dateEvenement|date_fr }}</a></p>
                        </div>
                    </div> <!-- dernier_evenement -->

                    <div class="spacer"><!-- --></div>

                {% endfor %}

            </div> <!-- Fin derniers_evenements -->

        </section> <!-- fin dernieres -->

    {% endif %}

</aside> <!-- Fin colonne_droite -->

<div class="spacer"><!-- --></div>
