parameters:
	ignoreErrors:
		# getAppVars() est marqué @deprecated (#158) mais reste appelé ici : 8 usages
		# dans les templates (_header.inc.php, _navigation_calendrier.inc.php) lisent
		# encore les globales qu'il alimente. Appel intentionnel, migration suivie
		# hors de #158 ; à retirer quand les liens seront composés depuis la région.
		-
			message: '#^Call to deprecated method getAppVars\(\) of class Ladecadanse\\RegionConfig\:#'
			identifier: method.deprecated
			count: 1
			path: app/bootstrap.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: evenement-edit.php

		-
			message: '#^Offset ''lien'' on array\{statut\: mixed, genre\: mixed, titre\: mixed, dateEvenement\: mixed, idLieu\: mixed, idSalle\: mixed, nomLieu\: mixed, adresse\: mixed, \.\.\.\} in empty\(\) does not exist\.$#'
			identifier: empty.offset
			count: 2
			path: evenement-edit.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: event/evenement.php

		-
			message: '#^Offset ''years'' on array\{mots\: mixed, tri\: mixed, periode\: mixed\} on left side of \?\?\= does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: event/search.php

		-
			message: '#^Variable \$image in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: librairies/EvenementRenderer.php

		-
			message: '#^Variable \$smallWidth in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: librairies/EvenementRenderer.php

		-
			message: '#^Property Ladecadanse\\EvenementWithSeparatorCollection\:\:\$date_current is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: librairies/EvenementWithSeparatorCollection.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 2
			path: librairies/HtmlShrink.php

		-
			message: '#^Left side of \|\| is always true\.$#'
			identifier: booleanOr.leftAlwaysTrue
			count: 1
			path: librairies/HtmlShrink.php

		-
			message: '#^Right side of \|\| is always true\.$#'
			identifier: booleanOr.rightAlwaysTrue
			count: 1
			path: librairies/HtmlShrink.php

		-
			message: '#^Variable \$counter might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: librairies/HtmlShrink.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: librairies/Organisateur.php

		-
			message: '#^Calling sha1\(\) is forbidden, use hash\(\) with at least SHA\-256 for secure hash, or password_hash\(\) for passwords\.$#'
			identifier: disallowed.function
			count: 2
			path: librairies/Security/Sentry.php

		-
			message: '#^Calling md5_file\(\) is forbidden, use hash_file\(\) with at least SHA\-256 for secure hash\.$#'
			identifier: disallowed.function
			count: 1
			path: librairies/Utils/AssetManager.php

		-
			message: '#^Calling mysqli_query\(\) is forbidden, use PDO\:\:prepare\(\) with variable binding/parametrized queries to prevent SQL Injection vulnerability\.$#'
			identifier: disallowed.function
			count: 2
			path: librairies/Utils/DbConnector.php

		-
			message: '#^Property Ladecadanse\\Utils\\DbConnector\:\:\$sql is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: librairies/Utils/DbConnector.php

		-
			message: '#^Method Ladecadanse\\Utils\\ImageDriver2\:\:getProportionalHeightFromGivenWidth\(\) should return int\|null but returns float\.$#'
			identifier: return.type
			count: 1
			path: librairies/Utils/ImageDriver2.php

		-
			message: '#^Offset ''mime'' on array\{0\: int\<0, max\>, 1\: int\<0, max\>, 2\: int, 3\: string, mime\: string, channels\?\: int, bits\?\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: librairies/Utils/ImageUrlFetcher.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: librairies/Utils/Text.php

		-
			message: '#^Expression "\\UPLOAD_MAX_FILESIZE" on a separate line does not do anything\.$#'
			identifier: expr.resultUnused
			count: 1
			path: lieu-edit.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: lieu-edit.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: lieu-edit.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: lieu-text-edit.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: lieu/lieux.php

		-
			message: '#^Offset 1 on array\{''Document introuvable'', ''Ce document n…''\}\|array\{''Erreur dans l…'', '' ''\}\|array\{''Trop de requêtes'', ''Le serveur reçoit…''\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: misc/error.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: organisateur-edit.php

		-
			message: '#^Calling sha1\(\) is forbidden, use hash\(\) with at least SHA\-256 for secure hash, or password_hash\(\) for passwords\.$#'
			identifier: disallowed.function
			count: 2
			path: user-edit.php

		-
			message: '#^Offset ''Sgroupe'' on non\-empty\-array\<mixed\> in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: user-edit.php
